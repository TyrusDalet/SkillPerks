# SkillPerks - Core 0 (Shared Files)
# Requires ErnPerkFramework.omwscripts and IE.omwscripts (Inventory Extender)
# to be loaded BEFORE this file.
#
# Contains the shared SkillPerks runtime only. Later cores depend on this
# package and add their own player-facing perk files separately.

GLOBAL:scripts/SkillPerks/global.lua
MENU:scripts/SkillPerks/Settings/menu_settings.lua
PLAYER:scripts/SkillPerks/Settings/settings_init.lua
PLAYER:scripts/SkillPerks/player.lua
NPC:scripts/SkillPerks/npc.lua
CREATURE:scripts/SkillPerks/creature.lua
